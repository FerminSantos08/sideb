DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=side_b
DB_USER=side_b_api
DB_PASSWORD=change_me
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_MINUTES=480
# Apache URLs reachable from Android. The API uses the one matching the
# requested API host, so devices on either known LAN receive usable image URLs.
MEDIA_BASE_URLS=http://10.223.22.245/SIDE_B,http://192.168.3.15/SIDE_B
# Fallback for localhost or an unknown host; never use a Windows filesystem path.
MEDIA_BASE_URL=http://192.168.3.15/SIDE_B
# Comma-separated browser origins only. Native Flutter does not require CORS.
CORS_ORIGINS=http://localhost:3000
